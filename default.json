{
  "extends": ["config:best-practices"],
  "semanticCommits": "enabled",
  "prConcurrentLimit": 3,
  "labels": ["dependencies"],
  "ignoreDeps": ["node"],
  "timezone": "CET",
  "schedule": [
    "* 0-7 * * 1-5"
  ],
  "abandonmentThreshold": "2 years",
  "packageRules": [
    {
      "matchUpdateTypes": ["patch"],
      "enabled": false
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "GitHub Actions (non-major)"
    },
    {
      "matchSourceUrls": ["https://github.com/triggerdotdev/trigger.dev"],
      "groupName": "trigger.dev monorepo packages"
    },
    {
      "matchDatasources": [
        "nuget"
      ],
      "description": "Group all NatchOS packages together",
      "groupName": "NatchOS",
      "patch": {
        "enabled": true
      },
      "matchPackageNames": [
        "NatchOS.{/,}**"
      ]
    },
    {
      "matchDatasources": [
        "nuget"
      ],
      "description": "Group all NatchCms packages together",
      "groupName": "NatchCms",
      "patch": {
        "enabled": true
      },
      "matchPackageNames": [
        "NatchCms.{/,}**"
      ]
    },
    {
      "matchDatasources": [
        "nuget"
      ],
      "description": "Group all Natch packages together",
      "groupName": "Natch",
      "patch": {
        "enabled": true
      },
      "matchPackageNames": [
        "Natch.{/,}**"
      ]
    },
    {
      "matchDatasources": [
        "nuget"
      ],
      "matchPackageNames": ["Autofac.Extensions.DependencyInjection", "NSubstitute"],
      "abandonmentThreshold": null
    },
    {
      "matchDatasources": [
        "nuget"
      ],
      "matchPackageNames": [
        "FluentAssertions"
      ],
      "dependencyDashboardNotes": [
        "⚠️ FluentAssertions should not be used anymore. Use AwesomeAssertions instead. This requires small code changes and cannot be performed automatically."
      ],
      "description": "FluentAssertions is forbidden; replace with AwesomeAssertions.",
      "labels": ["deprecated-library"]
    },
    {
      "matchDatasources": [
        "nuget"
      ],
      "matchPackageNames": [
        "AutoMapper"
      ],
      "dependencyDashboardNotes": [
        "⚠️ AutoMapper should not be used anymore. Use Mapster instead. This requires code changes and cannot be performed automatically."
      ],
      "description": "AutoMapper is forbidden; replace with Mapster.",
      "labels": ["deprecated-library"]
    }
  ]
}
