{
  "extends": ["config:best-practices"],
  "semanticCommits": "enabled",
  "prConcurrentLimit": 3,
  "labels": ["dependencies"],
  "ignoreDeps": ["node"],
  "timezone": "CET",
  "schedule": ["* 0-7 * * 1-5"],
  "abandonmentThreshold": "2 years",
  "lockFileMaintenance": {
    "enabled": false
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["patch"],
      "enabled": false
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "GitHub Actions (non-major)"
    },
    {
      "matchSourceUrls": ["https://github.com/triggerdotdev/trigger.dev"],
      "groupName": "trigger.dev monorepo packages"
    },
    {
      "matchDatasources": ["nuget"],
      "description": "Group all NatchOS packages together",
      "groupName": "NatchOS",
      "patch": {
        "enabled": true
      },
      "matchPackageNames": ["NatchOS.{/,}**"]
    },
    {
      "matchDatasources": ["nuget"],
      "description": "Group all NatchCms packages together",
      "groupName": "NatchCms",
      "patch": {
        "enabled": true
      },
      "matchPackageNames": ["NatchCms.{/,}**"]
    },
    {
      "matchDatasources": ["nuget"],
      "description": "Group all Natch packages together",
      "groupName": "Natch",
      "patch": {
        "enabled": true
      },
      "matchPackageNames": ["Natch.{/,}**"]
    },
    {
      "matchDatasources": ["nuget"],
      "matchPackageNames": ["Autofac.Extensions.DependencyInjection", "NSubstitute"],
      "abandonmentThreshold": null
    },
    {
      "matchDatasources": ["nuget"],
      "matchPackageNames": ["Natch.FluentEmailContrib"],
      "replacementName": "Alistar.FluentEmailContrib",
      "commitMessagePrefix": "⚠️",
      "commitMessageSuffix": "Alistar.FluentEmailContrib uses the newer jcamp.FluentEmail packages",
      "labels": ["deprecated-library"],
      "dependencyDashboardApproval": true
    },
    {
      "matchDatasources": ["nuget"],
      "matchPackageNames": ["FluentEmail.Core"],
      "replacementName": "jcamp.FluentEmail.Core",
      "commitMessagePrefix": "⚠️",
      "commitMessageSuffix": "The newer for should be used - original is abandoned.",
      "labels": ["deprecated-library"],
      "dependencyDashboardApproval": true
    },
    {
      "matchDatasources": ["nuget"],
      "matchPackageNames": ["FluentAssertions"],
      "replacementName": "AwesomeAssertions",
      "commitMessagePrefix": "⚠️",
      "commitMessageSuffix": "FluentAssertions is not cool anymore; replace with AwesomeAssertions.",
      "labels": ["deprecated-library"],
      "dependencyDashboardApproval": true
    },
    {
      "matchDatasources": ["nuget"],
      "matchPackageNames": ["AutoMapper"],
      "replacementName": "Mapster",
      "commitMessagePrefix": "⚠️",
      "commitMessageSuffix": "AutoMapper is not cool anymore; replace with Mapster.",
      "labels": ["deprecated-library"],
      "dependencyDashboardApproval": true
    },
    {
      "matchDatasources": ["nuget"],
      "matchPackageNames": ["Verify"],
      "replacementName": "Snapshooter",
      "commitMessagePrefix": "⚠️",
      "commitMessageSuffix": "Verify is not cool anymore; replace with Snapshooter.",
      "labels": ["deprecated-library"],
      "dependencyDashboardApproval": true
    },
    {
      "matchDatasources": ["nuget"],
      "matchPackageNames": ["Polly"],
      "replacementName": "Paramore.Fences",
      "commitMessagePrefix": "⚠️",
      "commitMessageSuffix": "Polly is not cool anymore; replace with Paramore.Fences.",
      "labels": ["deprecated-library"],
      "dependencyDashboardApproval": true
    },
    {
      "matchDatasources": ["npm"],
      "matchPackageNames": ["oxfmt", "oxlint", "oxlint-tsgolint"],
      "matchCurrentVersion": "/^0\\./",
      "enabled": false
    }
  ]
}
